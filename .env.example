HOTEL_DB_NAME=hotel_chain
HOTEL_DB_USER=hotel_app
HOTEL_DB_PASSWORD=change-for-local-development
HOTEL_DB_PORT=55432
HOTEL_API_PORT=4080
HOTEL_TEST_DB_NAME=hotel_chain_test
HOTEL_TEST_DB_USER=hotel_test
HOTEL_TEST_DB_PASSWORD=hotel_test
STAFF_DEV_ENABLED=true
STAFF_HQ_PASSWORD=choose-a-local-password
STAFF_SOKCHO_PASSWORD=choose-a-local-password
STAFF_SEORAKSAN_PASSWORD=choose-a-local-password
STAFF_JEJU_PASSWORD=choose-a-local-password
WEBSITE_MEDIA_STORAGE_MODE=local
WEBSITE_MEDIA_S3_ENDPOINT=
WEBSITE_MEDIA_S3_REGION=
WEBSITE_MEDIA_S3_BUCKET=
WEBSITE_MEDIA_S3_PATH_STYLE=false
WEBSITE_MEDIA_S3MOCK_PORT=59090
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
PAYMENT_PROVIDER=fake
# 신규 결제창 생성 스위치. 운영 전환 절차에서만 true로 바꾼다.
PAYMENT_CHECKOUT_ENABLED=false
# 결제창형: test_gck_/test_gsk_ 한 쌍. 기존 개별 연동 test_ck_/test_sk_도 지원한다.
TOSS_PAYMENTS_CLIENT_KEY=
TOSS_PAYMENTS_SECRET_KEY=
# 임의 이름이 아닌 해당 토스 상점의 실제 MID(결제 응답 mId)를 입력한다.
TOSS_PAYMENTS_MERCHANT_ACCOUNT=
PAYMENT_CUSTOMER_ORIGIN=http://127.0.0.1:4000
# 애플리케이션 인스턴스별 webhook 초당 한도. ingress에도 별도 제한을 둔다.
TOSS_WEBHOOK_MAX_PER_SECOND=120

# COMPOSE_PROJECT_NAME 은 .env 가 아닌 별도 파일로 지정한다.
# docker compose 가 .env 를 자동으로 읽으면 변수 보간 순서가 꼬인다.
COMPOSE_PROJECT_NAME=hotel-chain-manager
APP_VERSION=local

# DB. 처음 기동할 때만 만들어지고, 이후에는 .env 를 바꿔도
# 이미 만들어진 데이터베이스에 영향을 주지 않는다.
HCM_DB_NAME=hotel_chain
HCM_DB_USER=hotel_app
# 외부에서 DB 포트를 노출하지 않으므로 이 값은 컨테이너 내부에서만 쓰인다.
HCM_DB_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD

# 호스트 포트. 127.0.0.1 에만 바인딩된다. 3100~3104·3200 은
# 기존 프로젝트(b2b-stm·sdtpl-adm·real-es·music-pie·alpha-momega)가 쓴다.
HCM_API_PORT=3201
HCM_WEB_PORT=3110
HCM_ADMIN_PORT=3111

# Spring profile. dev 는 개발용 직원 시드와 테스트 결제를 켠다.
SPRING_PROFILES=dev

# 개발용 직원 계정. STAFF_DEV_ENABLED=true 여야 시드가 동작한다.
# 라이브 운영용 비밀번호를 넣더라도 커밋하지 않는다.
STAFF_DEV_ENABLED=false
STAFF_HQ_PASSWORD=
STAFF_SOKCHO_PASSWORD=
STAFF_SEORAKSAN_PASSWORD=
STAFF_JEJU_PASSWORD=

# 결제·정산. 첫 배포에서는 가짜 결제만 켠다.
# 실결제는 TOSS_PAYMENTS_* 키를 넣고 PAYMENT_PROVIDER=toss·
# PAYMENT_CHECKOUT_ENABLED=true 로 바꿔야 동작한다.
PAYMENT_PROVIDER=fake
PAYMENT_CHECKOUT_ENABLED=false
TOSS_PAYMENTS_CLIENT_KEY=
TOSS_PAYMENTS_SECRET_KEY=
TOSS_PAYMENTS_MERCHANT_ACCOUNT=
# 고객 결제가 끝난 뒤 돌아오는 공개 도메인이다.
PAYMENT_CUSTOMER_ORIGIN=https://hcm.approid.team

# 토스 정산 자동 동기화. 라이브 운영을 시작하기 전까지는 끈다.
TOSS_SETTLEMENT_ENABLED=false
TOSS_SETTLEMENT_PAGE_SIZE=500
TOSS_SETTLEMENT_DELAY_DAYS=2

# 웹사이트 미디어 저장. 첫 배포는 로컬 디스크(hcm-media-data 볼륨)를 쓴다.
# S3 를 쓰려면 WEBSITE_MEDIA_STORAGE_MODE=s3 와 아래 4개 값을 채운다.
WEBSITE_MEDIA_STORAGE_MODE=local
WEBSITE_MEDIA_S3_ENDPOINT=
WEBSITE_MEDIA_S3_REGION=
WEBSITE_MEDIA_S3_BUCKET=
WEBSITE_MEDIA_S3_PATH_STYLE=false

# 터널이 https 로 들어오므로 미리보기 링크도 https 를 요구한다.
WEBSITE_PREVIEW_REQUIRE_HTTPS=true

# 객실 유형을 만들 때 심는 기본 요금·재고.
HOTEL_SEED_DEFAULT_RATE_KRW=100000
HOTEL_SEED_RATE_DAYS=90
HOTEL_SEED_INVENTORY_CAPACITY=8

# 고객 웹 공개 도메인. 관리자 화면이 고객 웹 미리보기를 열 때 쓴다.
CUSTOMER_WEB_ORIGIN=https://hcm.approid.team

# AI 컨시어지. 이 배포에는 도우미가 없다. 비워두면 관리자의 /concierge
# rewrite 를 만들지 않고 AI 메뉴가 "실행 중이 아닙니다"를 보여준다.
# 도우미를 넣으려면 CONCIERGE_PROXY_TARGET=http://concierge:9000 로
# 바꾸고 GOOGLE_API_KEY 를 채운다.
CONCIERGE_PROXY_TARGET=
GOOGLE_API_KEY=
